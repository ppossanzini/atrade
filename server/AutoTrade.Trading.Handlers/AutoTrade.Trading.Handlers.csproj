<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Hikyaku" Version="10.0.2" />
    <PackageReference Include="Jigen.Store" Version="1.3.2" />
    <!-- In-process ONNX embedding: the same runtime that ranks the vectors also produces them, so retrieval
         never depends on an external engine being up (ADR-0025). It brings ONNX Runtime, Microsoft.ML.Tokenizers
         and OpenCvSharp5 along; the model checkpoint itself is a deployment artefact, not a package. -->
    <PackageReference Include="Jigen.SemanticTools" Version="1.3.2" />
    <!-- Stored evidence carries explicit MessagePack keys, so the format survives a property rename. -->
    <PackageReference Include="MessagePack" Version="3.1.7" />
    <PackageReference Include="MapZilla" Version="9.1.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoTrade.Trading.Core\AutoTrade.Trading.Core.csproj" />
  </ItemGroup>

  <!-- The vendored schema declares no package, so each file carries an explicit csharp_namespace. -->
  <ItemGroup>
    <Protobuf Include="Broker\Proto\*.proto" GrpcServices="None" ProtoRoot="Broker\Proto" />
  </ItemGroup>

</Project>
